    "prefix": ["froute", "flaxon-route"],
    "body": [
      "@app.${1:get}(\"${2:/api/${3:resource}}\")",
      "async def ${4:handler}(request):",
      "    \"\"\"${5:Handler description}.\"\"\"",
      "    return {\"message\": \"Hello from ${6:route}!\"}",
      ""
    ],
    "description": "Create a Flaxon route"
  },
